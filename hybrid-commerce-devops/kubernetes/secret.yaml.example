# Kubernetes Secrets - DO NOT commit real values
# Copy this file to secret.yaml and fill in real values
# Use: kubectl create secret generic hybrid-commerce-secret --from-env-file=secret.env

apiVersion: v1
kind: Secret
metadata:
  name: hybrid-commerce-secret
  namespace: hybrid-commerce
type: Opaque
stringData:
  SECRET_KEY: "change-this-in-production-use-kubectl-create-secret"
  POSTGRES_PASSWORD: "change-this-in-production"
---
# Alternative: Create via CLI (recommended)
# kubectl create secret generic hybrid-commerce-secret \
#   --from-literal=SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(32))") \
#   --from-literal=POSTGRES_PASSWORD=$(openssl rand -base64 32) \
#   -n hybrid-commerce
